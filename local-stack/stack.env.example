# =============================================================================
# stack.env 模板：本机覆盖项与密钥（复制为 stack.env 使用；stack.env 已 gitignore）。
# 原则：manifest.env 管版本（入库），stack.env 管本机差异与密钥（不入库）。
# 所有项都有默认值，纯 mock 闭环可以完全不建此文件。
# =============================================================================

# ---- 源码位置（开发机 build 用；默认取本仓上两级的工作区相对路径）----
#SERVICES_REPO=/path/to/odyss-services
#SUPERADMIN_REPO=/path/to/odyss-superadmin

# ---- LLM 模式：mock（默认，全离线闭环）| real（本机 vLLM，172.23.0.1:8000 直达宿主）----
#LLM_MODE=real

# ---- real 模式必填：本机 vLLM（宿主 vllm serve :8000）的 api key ----
#VLM_API_KEY=sk-odyss-g4-REPLACE_ME

# ---- superadmin 环境标识（页面右上角显示）----
#STACK_ID=local-stack
#STACK_LABEL=本地栈

# ---- bootstrap 建的管理账号 ----
#ADMIN_EMAIL=admin@odyss.local
#ADMIN_PASSWORD=Odyss@Local1
