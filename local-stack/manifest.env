# =============================================================================
# local-stack 版本清单（manifest）：「一套拉起」的唯一版本锚。
# 所有脚本（stack / build / bundle / bootstrap）统一 source 本文件取版本，
# 换版本只改这里，不改脚本与 compose。
# 本文件不含任何密钥；密钥一律放 gitignored 的 stack.env（见 stack.env.example）。
# =============================================================================

# ---- 业务组件源码仓与分支（构建阶段用）----
SERVICES_REPO_SLUG=sensimintel/odyss-services
SERVICES_REF=ifa
SUPERADMIN_REPO_SLUG=sensimintel/odyss-superadmin
SUPERADMIN_REF=ifa
# lumen（观测平台，overlay 编排见 lumen/）不在 ifa 窗口规则内，跟 main。
LUMEN_REPO_SLUG=sensimintel/odyss-lumen
LUMEN_REF=main

# ---- base 镜像（compose 与离线包共用同一清单）----
IMG_ALPINE=alpine:3.20
IMG_POSTGRES=postgres:18.4
IMG_REDIS=valkey/valkey:9.1.0
IMG_MINIO=minio/minio:latest
IMG_MINIO_MC=minio/mc:latest
IMG_NGINX=nginx:alpine

# ---- 真实 VLM（real 模式）----
# VLM=宿主 vllm serve :8000（本机 RTX Pro 6000，栈内经 172.23.0.1:8000 直达宿主），
# 暂无仓内部署单元，待沉淀。原 odyss-models/deploy/gcp-g4（frp 隧道链路）已废弃。
VLM_MODEL=Qwen3.6-35B-A3B-FP8
# 决策变更（2026-07-31）：ifa 分支的 services workflow YAML 的 meal 节点已改为直接写
# VLM_MODEL 真名（不再依赖 gemini-3.1-pro-preview 别名应答）。硬约束变为：
# VLM_MODEL 必须与本机 vLLM 的 --served-model-name 一致，切模型时两边同步改，
# 否则整餐分析 404。serve 侧仍保留 gemini 别名仅为旧二进制回滚兼容，可随时移除。
