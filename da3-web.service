# DA3 Web 8060 服务的 systemd 单元（可选）。
# 安装：sudo cp da3-web.service /etc/systemd/system/ && sudo systemctl daemon-reload
#       sudo systemctl enable --now da3-web.service
# 查日志：journalctl -u da3-web -f
[Unit]
Description=DA3 Web (Depth Anything 3 深度图 + 实时识别) 8060 服务
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=odyss
WorkingDirectory=/home/odyss/da3-web
# 双卡布局（2026-08-24 起）：DA3 深度模型（懒加载，峰值约 8.6G）与 SAM3 同落 GPU1=RTX 5090 32G，
# GPU0=RTX PRO 6000 独占给 vLLM(0.90)。按 UUID 钉卡，重启后不会落错卡
Environment=CUDA_VISIBLE_DEVICES=GPU-565f6e8d-550f-38cf-56d1-fe49fb280b05
ExecStart=/home/odyss/da3-web/run.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
