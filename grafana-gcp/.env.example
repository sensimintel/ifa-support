# grafana-gcp 配置样例：复制为同目录 .env 后按需改（.env 不入库）。
# up.sh / down.sh / docker compose 都会读这个 .env。

# ---- 本机 Grafana（局域网访问入口） ----
# 用 http://<本机内网IP>:${GRAFANA_PORT} 访问（在 5090 即 http://192.168.100.50:3001）。
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ---- 唯一数据源：本机 Prometheus ----
# 默认 9091（本机 9090 被 mihomo 代理占用）
LOCAL_PROM_PORT=9091
