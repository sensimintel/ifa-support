  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "请求 QPS",
      "description": "近 5 分钟平均(不含 /metrics /health)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_request_duration_seconds_count{service=\"sam3\",handler!~\"/metrics|/health|none\"}[5m]))",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "延时 P95",
      "description": "近 5 分钟整体 P95",
