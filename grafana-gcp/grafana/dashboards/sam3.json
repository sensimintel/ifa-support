          "expr": "100 * (sum(rate(http_requests_total{service=\"sam3\",status=~\"4xx|5xx\",handler!~\"/metrics|/health|none\"}[5m])) or vector(0)) / sum(rate(http_requests_total{service=\"sam3\",handler!~\"/metrics|/health|none\"}[5m]))",
          "refId": "A",
          "range": true
        }
      ]
    },
