{
  "title": "SAM3 服务观测 · RTX 5090",
  "uid": "sam3",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "sam3",
    "5090"
  ],
  "templating": {
    "list": [
      {
        "name": "gpu_uuid",
        "label": "GPU",
        "type": "query",
        "hide": 2,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(nvidia_smi_gpu_info{name=~\".*GeForce RTX 5090.*\"}, uuid)",
        "query": {
          "qryType": 1,
          "query": "label_values(nvidia_smi_gpu_info{name=~\".*GeForce RTX 5090.*\"}, uuid)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "接口 QPS(按端点)",
      "description": "各端点每秒请求数(不含 /metrics /health)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by(handler)(rate(http_request_duration_seconds_count{service=\"sam3\",handler!~\"/metrics|/health|none\"}[1m]))",
          "legendFormat": "{{handler}}",
          "refId": "A",
          "range": true
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "端到端延时 P95(按端点)",
      "description": "每端点 P95 处理延时",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by(handler,le)(rate(http_request_duration_seconds_bucket{service=\"sam3\",handler!~\"/metrics|/health|none\"}[5m])))",
          "legendFormat": "{{handler}}",
          "refId": "A",
          "range": true
        }
      ],
      "id": 2
    },
