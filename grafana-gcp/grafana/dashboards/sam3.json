        "label": "GPU",
        "type": "query",
        "hide": 2,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(nvidia_smi_gpu_info{name=~\".*GeForce RTX 5090.*\"}, uuid)",
        "query": {
          "qryType": 1,
          "query": "label_values(nvidia_smi_gpu_info{name=~\".*GeForce RTX 5090.*\"}, uuid)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": []
